# Copy this file to .env (and never commit .env) — or just export these
# directly in your shell before running the agent.

# Get this from console.anthropic.com. Set a monthly spend limit there too
# (Settings -> Billing -> Limits) so this project can never surprise-bill you.
ANTHROPIC_API_KEY=sk-ant-...

# SEC requires a descriptive User-Agent with real contact info on every
# request to EDGAR — this is free, no signup, no key. Just be a real
# name + email. See https://www.sec.gov/edgar/sec-api-documentation
EDGAR_USER_AGENT="Your Name your.email@example.com"

# Optional cost/behavior knobs — sane defaults are baked in if you skip these.
# LBO_AGENT_MODEL defaults to claude-haiku-4-5 (cheapest, ~3.5c/run). Bump to
# claude-sonnet-5 for a more polished memo. See docs/COST_CONTROL.md.
# LBO_AGENT_MODEL=claude-sonnet-5
# LBO_AGENT_MAX_TOKENS=3000
# LBO_AGENT_MAX_TURNS=8
